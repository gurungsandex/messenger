# Environment file for the systemd unit.
#
#   install -m 0600 -o root -g root messenger.env.example /etc/messenger/messenger.env
#
# Root-owned and mode 0600: this holds the passphrase protecting every key in the
# deployment. The service account does not need to read it — systemd reads it and passes the
# values in.
#
# Double underscore is the .NET configuration separator, so KeyStore__Passphrase sets the
# "KeyStore:Passphrase" key. Values are taken literally — do not quote them.

ASPNETCORE_URLS=http://127.0.0.1:8080

ConnectionStrings__Messenger=Host=localhost;Port=5432;Database=messenger;Username=messenger;Password=CHANGE_ME;SSL Mode=Require

# Protects the root KEK and the audit checkpoint signing key. Not rotatable: lose it and all
# message and file history is permanently unreadable. Escrow it before the first start.
#   openssl rand -base64 32
KeyStore__Passphrase=CHANGE_ME

# StateDirectory=messenger in the unit resolves to /var/lib/messenger.
KeyStore__EscrowPath=/var/lib/messenger/keystore/root.escrow
AuditSigningKey__EscrowPath=/var/lib/messenger/keystore/audit-signing.escrow
FileStore__RootPath=/var/lib/messenger/filestore

# Base64 Ed25519 public key of the licence signer, supplied with the licence.
Licensing__VendorPublicKey=CHANGE_ME

# Set only if a reverse proxy terminates TLS in front of this server, and name the hop it
# connects from. Enabling this without naming a trusted proxy or network makes the setting a
# no-op — the server logs a warning saying so at startup.
#ForwardedHeaders__Enabled=true
#ForwardedHeaders__KnownProxies__0=10.0.0.5
