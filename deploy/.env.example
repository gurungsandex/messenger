# Copy to .env beside docker-compose.yml and fill in. .env is gitignored; keep it out of
# version control and treat it as key material, not configuration.

# --- Database -----------------------------------------------------------------------
POSTGRES_DB=messenger
POSTGRES_USER=messenger
# openssl rand -base64 24
POSTGRES_PASSWORD=

# --- Key store --------------------------------------------------------------------
# Protects the root KEK and the audit checkpoint signing key.
#
# This is not a rotatable credential. Lose it and every message and file ever encrypted by
# this deployment is permanently unreadable, and the audit chain can no longer prove its
# origin — database backups will not save you. Escrow it wherever the organisation keeps
# recovery secrets, before the first start.
#
# openssl rand -base64 32
KEYSTORE_PASSPHRASE=

# --- Licensing --------------------------------------------------------------------
# Base64 Ed25519 public key of the vendor that signs licence files. Supplied with the
# licence; validation is fully offline, so the server never contacts the vendor.
VENDOR_PUBLIC_KEY=

# --- Network ----------------------------------------------------------------------
# The network the reverse proxy connects from. Only hops listed here have their
# X-Forwarded-For honoured; anything else is ignored, which is the safe reading of an
# incomplete configuration.
TRUSTED_PROXY_NETWORK=172.16.0.0/12

# Address the published port binds to. Loopback by default so the server is reachable only
# through the reverse proxy — set to 0.0.0.0 only if you intend to expose it directly.
SERVER_BIND=127.0.0.1
