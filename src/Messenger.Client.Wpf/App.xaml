<Application x:Class="Messenger.Client.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Messenger.Client.Wpf.ViewModels"
             xmlns:views="clr-namespace:Messenger.Client.Wpf.Views">
    <Application.Resources>
        <DataTemplate DataType="{x:Type vm:LoginViewModel}">
            <views:LoginView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ChangePasswordViewModel}">
            <views:ChangePasswordView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MainViewModel}">
            <views:MainView />
        </DataTemplate>
    </Application.Resources>
</Application>
