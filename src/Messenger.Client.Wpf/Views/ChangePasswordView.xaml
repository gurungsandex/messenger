<UserControl x:Class="Messenger.Client.Wpf.Views.ChangePasswordView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="320">
            <TextBlock Text="Change your password" FontSize="22" FontWeight="Bold" Margin="0,0,0,8" HorizontalAlignment="Center" />
            <TextBlock Text="The server requires a new password before you can continue." TextWrapping="Wrap" Margin="0,0,0,20" Opacity="0.7" />

            <TextBlock Text="Current password" Margin="0,0,0,4" />
            <PasswordBox x:Name="CurrentPasswordBox" Margin="0,0,0,12" />

            <TextBlock Text="New password" Margin="0,0,0,4" />
            <PasswordBox x:Name="NewPasswordBox" Margin="0,0,0,12" />

            <TextBlock Text="Confirm new password" Margin="0,0,0,4" />
            <PasswordBox x:Name="ConfirmPasswordBox" Margin="0,0,0,16" />

            <Button Content="Change password" Click="Submit_Click" Padding="8" />

            <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap" Margin="0,12,0,0" />
            <TextBlock Text="{Binding StatusMessage}" Foreground="Green" TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
