<UserControl x:Class="Messenger.Admin.Wpf.Views.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <TabControl Margin="8">

        <!-- Dashboard -->
        <TabItem Header="Dashboard" DataContext="{Binding Dashboard}">
            <StackPanel Margin="12">
                <Button Content="Refresh" Command="{Binding RefreshCommand}" HorizontalAlignment="Left" Padding="6,3" Margin="0,0,0,12" />
                <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" Margin="0,0,0,12" />

                <TextBlock Text="Server health" FontWeight="Bold" FontSize="16" Margin="0,0,0,6" />
                <StackPanel DataContext="{Binding Health}" Margin="0,0,0,20">
                    <TextBlock Text="{Binding DatabaseReachable, StringFormat='Database reachable: {0}'}" />
                    <TextBlock Text="{Binding ActiveSessions, StringFormat='Active sessions: {0}'}" />
                    <TextBlock Text="{Binding Users, StringFormat='Users: {0}'}" />
                    <TextBlock Text="{Binding Groups, StringFormat='Groups: {0}'}" />
                    <TextBlock Text="{Binding Messages, StringFormat='Messages: {0}'}" />
                    <TextBlock Text="{Binding PendingDeliveries, StringFormat='Pending deliveries: {0}'}" />
                    <TextBlock Text="{Binding License, StringFormat='Licence state: {0}'}" />
                    <TextBlock Text="{Binding ServerTime, StringFormat='Server time: {0}'}" />
                </StackPanel>

                <TextBlock Text="Licence" FontWeight="Bold" FontSize="16" Margin="0,0,0,6" />
                <StackPanel DataContext="{Binding License}">
                    <TextBlock Text="{Binding Customer, StringFormat='Customer: {0}'}" />
                    <TextBlock Text="{Binding State, StringFormat='State: {0}'}" />
                    <TextBlock Text="{Binding SeatsUsed, StringFormat='Seats used: {0}'}" />
                    <TextBlock Text="{Binding SeatsAllowed, StringFormat='Seats allowed: {0}'}" />
                    <TextBlock Text="{Binding Expires, StringFormat='Expires: {0}'}" />
                </StackPanel>
            </StackPanel>
        </TabItem>

        <!-- Users -->
        <TabItem Header="Users" DataContext="{Binding Users}">
            <DockPanel Margin="12">
                <TextBlock DockPanel.Dock="Top" Text="{Binding ErrorMessage}" Foreground="Red" Margin="0,0,0,8" />

                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="Refresh" Command="{Binding RefreshCommand}" Padding="6,3" Margin="0,0,8,0" />
                    <Button Content="Toggle active/disabled" Command="{Binding ToggleStatusCommand}" Padding="6,3" />
                </StackPanel>

                <GroupBox DockPanel.Dock="Bottom" Header="Create user" Margin="0,8,0,0" Padding="8">
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="NewUsername" Width="140" Margin="0,0,6,0" />
                        <TextBox x:Name="NewDisplayName" Width="140" Margin="0,0,6,0" />
                        <TextBox x:Name="NewEmail" Width="160" Margin="0,0,6,0" />
                        <PasswordBox x:Name="NewPassword" Width="160" Margin="0,0,6,0" />
                        <Button Content="Create" Click="CreateUser_Click" Padding="6,3" />
                    </StackPanel>
                </GroupBox>

                <DataGrid ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}"
                          AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Username" Binding="{Binding Username}" />
                        <DataGridTextColumn Header="Display name" Binding="{Binding DisplayName}" />
                        <DataGridTextColumn Header="Email" Binding="{Binding Email}" />
                        <DataGridTextColumn Header="Source" Binding="{Binding Source}" />
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" />
                        <DataGridTextColumn Header="Last login" Binding="{Binding LastLoginAt}" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </TabItem>

        <!-- Groups -->
        <TabItem Header="Groups" DataContext="{Binding Groups}">
            <DockPanel Margin="12">
                <TextBlock DockPanel.Dock="Top" Text="{Binding ErrorMessage}" Foreground="Red" Margin="0,0,0,8" />

                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="Refresh" Command="{Binding RefreshCommand}" Padding="6,3" Margin="0,0,8,0" />
                    <TextBox Text="{Binding NewGroupName, UpdateSourceTrigger=PropertyChanged}" Width="160" Margin="0,0,6,0" />
                    <Button Content="Create group" Command="{Binding CreateGroupCommand}" Padding="6,3" Margin="0,0,16,0" />
                    <TextBox Text="{Binding MemberUserId, UpdateSourceTrigger=PropertyChanged}" Width="220"
                             ToolTip="Member user id (guid)" Margin="0,0,6,0" />
                    <Button Content="Add member" Command="{Binding AddMemberCommand}" Padding="6,3" Margin="0,0,6,0" />
                    <Button Content="Remove member" Command="{Binding RemoveMemberCommand}" Padding="6,3" Margin="0,0,6,0" />
                    <Button Content="Toggle active/disabled" Command="{Binding ToggleStatusCommand}" Padding="6,3" Margin="0,0,6,0" />
                    <Button Content="Delete" Command="{Binding DeleteGroupCommand}" Padding="6,3" />
                </StackPanel>

                <DataGrid ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}"
                          AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" />
                        <DataGridTextColumn Header="Description" Binding="{Binding Description}" />
                        <DataGridTextColumn Header="Type" Binding="{Binding Type}" />
                        <DataGridTextColumn Header="Source" Binding="{Binding Source}" />
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" />
                        <DataGridTextColumn Header="Members" Binding="{Binding MemberCount}" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </TabItem>

        <!-- Sessions -->
        <TabItem Header="Sessions" DataContext="{Binding Sessions}">
            <DockPanel Margin="12">
                <TextBlock DockPanel.Dock="Top" Text="{Binding ErrorMessage}" Foreground="Red" Margin="0,0,0,8" />
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="Refresh" Command="{Binding RefreshCommand}" Padding="6,3" Margin="0,0,8,0" />
                    <Button Content="Revoke selected" Command="{Binding RevokeCommand}" Padding="6,3" />
                </StackPanel>

                <DataGrid ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}"
                          AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Username" Binding="{Binding Username}" />
                        <DataGridTextColumn Header="Device" Binding="{Binding DeviceName}" />
                        <DataGridTextColumn Header="IP" Binding="{Binding IpAddress}" />
                        <DataGridTextColumn Header="Auth method" Binding="{Binding AuthMethod}" />
                        <DataGridTextColumn Header="Created" Binding="{Binding CreatedAt}" />
                        <DataGridTextColumn Header="Last activity" Binding="{Binding LastActivityAt}" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </TabItem>

        <!-- Audit -->
        <TabItem Header="Audit" DataContext="{Binding Audit}">
            <DockPanel Margin="12">
                <TextBlock DockPanel.Dock="Top" Text="{Binding ErrorMessage}" Foreground="Red" Margin="0,0,0,8" />
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="Refresh" Command="{Binding RefreshCommand}" Padding="6,3" Margin="0,0,8,0" />
                    <Button Content="Verify chain" Command="{Binding VerifyCommand}" Padding="6,3" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding VerificationResult}" VerticalAlignment="Center" />
                </StackPanel>

                <DataGrid ItemsSource="{Binding Entries}" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Occurred" Binding="{Binding OccurredAt}" />
                        <DataGridTextColumn Header="Actor" Binding="{Binding ActorUserId}" />
                        <DataGridTextColumn Header="Tier" Binding="{Binding ActorTier}" />
                        <DataGridTextColumn Header="Action" Binding="{Binding Action}" />
                        <DataGridTextColumn Header="Target" Binding="{Binding TargetType}" />
                        <DataGridTextColumn Header="Outcome" Binding="{Binding Outcome}" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </TabItem>

        <!-- Licence -->
        <TabItem Header="Licence" DataContext="{Binding License}">
            <StackPanel Margin="12">
                <Button Content="Refresh" Command="{Binding RefreshCommand}" HorizontalAlignment="Left" Padding="6,3" Margin="0,0,0,12" />
                <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" Margin="0,0,0,8" />
                <TextBlock Text="{Binding StatusMessage}" Foreground="Green" Margin="0,0,0,12" />

                <StackPanel DataContext="{Binding Status}" Margin="0,0,0,20">
                    <TextBlock Text="{Binding State, StringFormat='State: {0}'}" />
                    <TextBlock Text="{Binding Customer, StringFormat='Customer: {0}'}" />
                    <TextBlock Text="{Binding SeatsUsed, StringFormat='Seats used: {0}'}" />
                    <TextBlock Text="{Binding SeatsAllowed, StringFormat='Seats allowed: {0}'}" />
                    <TextBlock Text="{Binding Expires, StringFormat='Expires: {0}'}" />
                    <TextBlock Text="{Binding GraceEndsAt, StringFormat='Grace ends: {0}'}" />
                </StackPanel>

                <TextBlock Text="Install a licence file" FontWeight="Bold" Margin="0,0,0,6" />
                <TextBlock Text="Paste the .lic file's exact contents (do not reformat it -- any edit invalidates its signature):"
                           TextWrapping="Wrap" Margin="0,0,0,6" Opacity="0.7" />
                <TextBox x:Name="LicenseFileBox" Height="80" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" Margin="0,0,0,8" />
                <Button Content="Install" Click="InstallLicense_Click" HorizontalAlignment="Left" Padding="6,3" />
            </StackPanel>
        </TabItem>

        <!-- Directory sync -->
        <TabItem Header="Directory sync" DataContext="{Binding DirectorySync}">
            <StackPanel Margin="12">
                <TextBlock Text="LDAPS binding is not implemented yet -- this will return AD-101 until a domain controller and the wire binding exist."
                           TextWrapping="Wrap" Foreground="DarkOrange" Margin="0,0,0,12" />
                <Button Content="Sync now" Command="{Binding SyncCommand}" HorizontalAlignment="Left" Padding="6,3" Margin="0,0,0,12" />
                <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" Margin="0,0,0,12" />

                <StackPanel DataContext="{Binding LastReport}">
                    <TextBlock Text="{Binding Succeeded, StringFormat='Succeeded: {0}'}" />
                    <TextBlock Text="{Binding UsersAdded, StringFormat='Users added: {0}'}" />
                    <TextBlock Text="{Binding UsersUpdated, StringFormat='Users updated: {0}'}" />
                    <TextBlock Text="{Binding UsersDeactivated, StringFormat='Users deactivated: {0}'}" />
                    <TextBlock Text="{Binding GroupsAdded, StringFormat='Groups added: {0}'}" />
                    <TextBlock Text="{Binding GroupsUpdated, StringFormat='Groups updated: {0}'}" />
                    <TextBlock Text="{Binding WasFullReconcile, StringFormat='Full reconcile: {0}'}" />
                </StackPanel>
            </StackPanel>
        </TabItem>

    </TabControl>
</UserControl>
